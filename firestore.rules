rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'dgookt@gmail.com') || 
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.isVerified == true)
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'manager' && 
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.isVerified == true)
      );
    }

    function isStaff() {
      return isSignedIn() && (
        (request.auth.token.email == 'dgookt@gmail.com') || 
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.isVerified == true)
      );
    }

    function canModify() {
      return isStaff();
    }

    function canManageStaff() {
      return isAdmin() || isManager();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidMedication(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && data.category.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.stockLevel is number && data.stockLevel >= 0;
    }

    function isValidSale(data) {
      return data.items is list && data.items.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.paymentMethod in ['cash', 'card', 'mobile_money'];
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    function isValidStaff(data) {
      return data.name is string && data.name.size() > 0 &&
             data.role in ['admin', 'pharmacist', 'cashier', 'manager', 'technician', 'viewer'] &&
             data.isVerified is bool;
    }

    function isValidConsultation(data) {
      return data.userId is string &&
             data.messages is list;
    }

    function isValidStockLog(data) {
      return data.medicationId is string &&
             data.change is number &&
             data.reason is string;
    }

    // --- Collection Rules ---

    // Medications
    match /medications/{medicationId} {
      allow read: if isSignedIn();
      allow create: if isStaff() && isValidId(medicationId) && isValidMedication(incoming());
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Sales
    match /sales/{saleId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(saleId) && isValidSale(incoming());
      allow update, delete: if isAdmin(); 
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Consultations
    match /consultations/{consultationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && isValidConsultation(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isStaff());
      allow delete: if isAdmin();
    }

    // Staff
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (staffId == request.auth.uid || isAdmin()) && isValidStaff(incoming()); 
      allow update: if (canManageStaff() || (isSignedIn() && staffId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Stock Logs
    match /stockLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(logId) && isValidStockLog(incoming());
      allow update, delete: if isAdmin();
    }

    // Staff Activities
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Test connection
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
